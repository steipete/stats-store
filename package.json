{
  "name": "stats-store",
  "version": "0.1.1",
  "private": true,
  "description": "Privacy-focused analytics dashboard for Sparkle-enabled macOS applications",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm format:check && oxlint -c .oxlintrc.json --deny-warnings --import-plugin --react-plugin --nextjs-plugin --vitest-plugin --type-aware --tsconfig tsconfig.oxlint.json app components hooks lib tests",
    "lint:fix": "pnpm format && oxlint -c .oxlintrc.json --deny-warnings --import-plugin --react-plugin --nextjs-plugin --vitest-plugin --type-aware --tsconfig tsconfig.oxlint.json --fix app components hooks lib tests",
    "start": "next start",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run",
    "test:api": "cross-env NODE_NO_WARNINGS=1 vitest run --project api",
    "test:components": "cross-env NODE_NO_WARNINGS=1 vitest run tests/components",
    "test:coverage": "cross-env NODE_NO_WARNINGS=1 vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.4.1"
  },
  "packageManager": "pnpm@12.4.1"
}
