{
  "plugins": ["unicorn", "oxc"],
  "rules": {
    "eslint/no-await-in-loop": "allow",
    "jest/expect-expect": "allow",
    "jest/no-conditional-expect": "allow",
    "nextjs/no-html-link-for-pages": "allow",
    "react/react-in-jsx-scope": "allow",
    "unicorn/consistent-function-scoping": "allow",
    "vitest/require-mock-type-parameters": "allow"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/.next/**", "**/coverage/**", "**/dist/**"]
}
